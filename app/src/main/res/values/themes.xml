<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AURAPASS2026" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/brand_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- BottomNavigationView 스타일 -->
        <item name="bottomNavigationStyle">@style/Widget.AURAPASS.BottomNavigation</item>
    </style>

    <style name="Widget.AURAPASS.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">22dp</item>
    </style>
</resources>
