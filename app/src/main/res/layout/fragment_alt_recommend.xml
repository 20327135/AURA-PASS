<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="대체 추천" android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/black" android:layout_marginBottom="4dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="시스템 점검 중 — 인기 상품 기반으로 추천을 안내드립니다."
        android:textSize="13sp" android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="인기 상품 TOP 5" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/black" android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_popular_products"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <Button android:id="@+id/btn_back_to_error" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="장애 안내 화면으로 돌아가기"
        android:backgroundTint="@color/surface" android:textColor="@color/black" />

</LinearLayout>
