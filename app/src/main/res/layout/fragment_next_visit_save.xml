<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="다음 방문 저장 목록" android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/black" android:layout_marginBottom="4dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="상담 시 참고할 룩과 요청 사항을 관리하세요." android:textSize="13sp"
        android:textColor="@color/text_secondary" android:layout_marginBottom="20dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="저장된 룩" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/black" android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_saved_looks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <Button android:id="@+id/btn_add_consult_request" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="상담 요청 등록"
        android:backgroundTint="@color/black" android:textColor="@color/white" />

</LinearLayout>
